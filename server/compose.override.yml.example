# Copy to compose.override.yml to let Airkeep serve HTTPS using an existing certificate.
services:
  web:
    user: ${AIRKEEP_TLS_UID:-1000}:${AIRKEEP_TLS_GID:-1000}
    environment:
      AIRKEEP_TLS_ENABLED: 'true'
      AIRKEEP_HOST: ${AIRKEEP_HOST:?Set AIRKEEP_HOST to the certificate-covered hostname}
      AIRKEEP_TLS_RELOAD_SECONDS: '60'
    ports:
      - '${AIRKEEP_BIND_ADDRESS:-127.0.0.1}:${AIRKEEP_HTTPS_PORT:-8443}:8443'
    volumes:
      - type: bind
        source: ${AIRKEEP_TLS_DIR:?Set AIRKEEP_TLS_DIR to the ACME-managed certificate directory}
        target: /run/tls
        read_only: true
        bind:
          create_host_path: false
