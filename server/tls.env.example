# Copy to .env when using compose.tls.yml. No credentials belong here.
AIRKEEP_IMAGE_TAG=0.3.0
AIRKEEP_HOST=airkeep.example.com
AIRKEEP_BIND_ADDRESS=127.0.0.1
AIRKEEP_HTTPS_PORT=8443
AIRKEEP_TLS_DIR=/path/to/acme-managed/certificates
# Match the certificate files' owner without broadening key permissions.
AIRKEEP_TLS_UID=1000
AIRKEEP_TLS_GID=1000
