AIRKEEP_PRINTER_IP=192.0.2.10
AIRKEEP_PRINTER_SERIAL=YOUR_PRINTER_SERIAL
AIRKEEP_PRINTER_CODE=YOUR_LAN_ACCESS_CODE
AIRKEEP_API_TOKEN=GENERATE_WITH_openssl_rand_hex_32
AIRKEEP_DB_PATH=.local/airkeep.sqlite3
# Native app and widget use the same relay URL and bearer token.
# Use HTTPS via Tailscale Serve or your own trusted reverse proxy outside loopback.
# APNs is optional until configured. Never commit the .p8 file.
AIRKEEP_APNS_TEAM_ID=
AIRKEEP_APNS_KEY_ID=
AIRKEEP_APNS_KEY_PATH=
# Topic-restricted keys use a sandbox key above and a separate production key:
AIRKEEP_APNS_KEY_ENVIRONMENT=sandbox
AIRKEEP_APNS_PRODUCTION_KEY_ID=
AIRKEEP_APNS_PRODUCTION_KEY_PATH=
AIRKEEP_IOS_TOPIC=io.airkeep
AIRKEEP_MAC_TOPIC=io.airkeep.mac

# Browser owner access. Generate a quoted hash with: uv run setup_web.py
AIRKEEP_WEB_PASSWORD_HASH=
AIRKEEP_WEB_ORIGIN=
# Watch widget push credentials (separate topic-authorized keys).
AIRKEEP_WATCH_TOPIC=io.airkeep.watch
AIRKEEP_WATCH_APNS_KEY_ID=
AIRKEEP_WATCH_APNS_KEY_PATH=/run/keys/watch-sandbox.p8
AIRKEEP_WATCH_APNS_PRODUCTION_KEY_ID=
AIRKEEP_WATCH_APNS_PRODUCTION_KEY_PATH=/run/keys/watch-production.p8
AIRKEEP_WATCH_APNS_USE_SHARED_CREDENTIALS=false
